# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# Resend
RESEND_API_KEY=
RESEND_FROM="Wedding Planning <planning@yourdomain.com>"   # domain must be verified in Resend

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # your Vercel URL in production
OWNER_EMAIL=you@example.com                  # the one email allowed to bootstrap the wedding as owner
WEDDING_NAME="Our Wedding"

# Vercel cron auth: any long random string. Vercel sends it as a Bearer token.
CRON_SECRET=
